# Исходники и документация: LF в репозитории
* text=auto eol=lf

# Сценарии Windows должны оставаться с CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf

# Двоичные файлы: без преобразования окончаний строк
*.exe binary
*.dll binary
*.png binary
*.ico binary
*.pdf binary
*.pptx binary
*.docx binary
*.zip binary
*.p12 binary
*.pfx binary
*.cer binary
*.crt binary
*.der binary
*.p7b binary
*.pem binary
